# Copy to /srv/docker/chipseq/.env beside compose.yaml.
#
# The relay itself reads NO environment variables - it is configured entirely
# by the CLI arguments in the Dockerfile. Everything here is for compose, so
# this file describes where the service sits on the box, not how it behaves.

# The Docker network Caddy is attached to. Must already exist:
# compose declares it external so a typo fails the deploy instead of silently
# creating a second network Caddy cannot reach.
PROXY_NETWORK=edge

# The upstream name Caddy will proxy to. Whatever you put here has to match the
# reverse_proxy line in the site file, so they are one decision, not two.
CONTAINER_NAME=chipseq-relay

# The image to run. Written by deploy-chipseq on every deploy, which is why it
# is a variable rather than a literal in compose.yaml: rolling back is then one
# line here rather than an edit to the service definition.
#
# `latest` here only so a fresh copy of this file runs without editing it. A
# deployed box always holds a VERSION tag, because deploy-chipseq writes one and
# because a moving tag cannot be rolled back to - it stops pointing at the thing
# you want to go back to.
RELAY_IMAGE=ghcr.io/n0ctu/chipseq-relay:latest

# The tag that was running before the current one. deploy-chipseq restores this
# when a new image fails its health gate, so the rollback needs no lookup at the
# one moment lookups are least welcome.
RELAY_IMAGE_PREVIOUS=ghcr.io/n0ctu/chipseq-relay:latest

# Building locally instead of pulling - hacking on the relay at the venue, or
# any time the registry is not reachable:
#   docker build -f app/server/Dockerfile -t chipseq-relay:local app
#   RELAY_IMAGE=chipseq-relay:local docker compose up -d
# The deploy timer would overwrite that on its next run, so stop it first:
#   sudo systemctl stop chipseq-deploy.timer

# Not read by compose. Recorded here because the Caddy site file and the DNS
# record have to agree with it, and one place to look beats three:
#   PUBLIC_HOST=ws.chipseq.app
