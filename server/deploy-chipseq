#!/usr/bin/env bash
# Deploys the newest released relay image, and puts the old one back if it does
# not come up. Run from a timer on the box:
#
#   /srv/docker/chipseq/deploy-chipseq            # deploy newest, if any
#   /srv/docker/chipseq/deploy-chipseq --force    # accepted, and does nothing
#   /srv/docker/chipseq/deploy-chipseq --rollback # go back one tag, now
#   /srv/docker/chipseq/deploy-chipseq --image REF # deploy exactly this one
#
# The deploy is a line in .env plus `docker compose up -d`, so rolling back is
# an edit rather than a rebuild on a live box. That is the whole reason the
# image is pinned by version and never deployed as `latest`: a moving tag stops
# pointing at the thing you would want to return to.
set -euo pipefail

DIR="${CHIPSEQ_DIR:-/srv/docker/chipseq}"
ENV_FILE="$DIR/.env"
IMAGE="${CHIPSEQ_IMAGE:-ghcr.io/n0ctu/chipseq-relay}"
HEALTH_URL="${CHIPSEQ_HEALTH_URL:-https://ws.chipseq.app/health}"
DEADLINE_S="${CHIPSEQ_DEADLINE_S:-120}"
# Where compose.yaml is read from at deploy time. Set empty to disable the sync
# and manage the file by hand.
REPO_RAW="${CHIPSEQ_REPO_RAW:-https://raw.githubusercontent.com/n0ctu/ChipSeq}"

FORCE=0
ROLLBACK=0
PINNED=""
while [ $# -gt 0 ]; do
  case "$1" in
    # Kept so existing timers and muscle memory do not break. There is no
    # longer anything to force past: deploys used to defer while badges were
    # online, which turned a busy relay into one that never updated at all,
    # and adoptions now survive a restart anyway.
    --force) FORCE=1 ;;
    --rollback) ROLLBACK=1 ;;
    # Deploy a named image instead of whatever the registry says is newest:
    # rolling forward to a known-good tag, and how the health gate and the
    # rollback are exercised without waiting for a real bad release.
    --image) PINNED="${2:?--image needs a reference}"; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

log() { echo "$(date -Is) $*"; }

# ---- one deploy at a time ----
#
# systemd will not run two copies of a oneshot service, so the timer cannot
# overlap itself. A manual run alongside a timer-fired one can, and both write
# .env - which is not merely untidy, because .env is what the rollback path
# trusts. Interleave the three writes in deploy() and you can end up with
# RELAY_IMAGE naming one image, the container running another, and
# RELAY_IMAGE_PREVIOUS pointing at something that was never live. A rollback
# reading that would restore the wrong thing, at the moment it is least wanted.
#
# The lock is held on a file descriptor, not by the file existing, so it is
# released even if this script is killed - there is no stale lock to clear.
LOCK_WAIT_S="${CHIPSEQ_LOCK_WAIT_S:-600}"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$DIR/.deploy.lock"
  if ! flock -w "$LOCK_WAIT_S" 9; then
    log "another deploy has held the lock for ${LOCK_WAIT_S}s - something is stuck"
    exit 1
  fi
else
  # Not fatal: a box without util-linux still deploys, it just loses the
  # guarantee. Say so rather than pretending the lock was taken.
  log "warning: flock not found, running without a lock"
fi

# .env is the source of truth for what is running, because compose reads it and
# because a rollback must not need a registry lookup at the one moment lookups
# are least welcome.
get_env() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -1; }
set_env() {
  local key="$1" value="$2"
  if grep -qE "^$key=" "$ENV_FILE"; then
    sed -i "s|^$key=.*|$key=$value|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

compose() { docker compose --project-directory "$DIR" "$@"; }

# compose.yaml belongs to the release, not to the box.
#
# Deploying only the image is how a release can look successful and do nothing:
# `--db` lives in compose's `command:`, not in the Dockerfile CMD, so an image
# built to persist adoptions runs happily in memory when the box is still on the
# previous compose.yaml - healthy, gate passed, feature silently absent. The
# reverse pairing is worse in a different way: `command:` without its volume
# puts the database on a read-only root and crash-loops.
#
# So the file is fetched at the tag being deployed, and the old one is kept for
# the rollback: putting an image back while leaving the newer compose.yaml in
# place is a combination that was never tested and need not be.
#
# Every failure here is non-fatal on purpose. A registry blip, no network at a
# venue, or a tag with no compose.yaml should leave the box deploying with the
# file it already has, not refuse to deploy at all.
# Set when this run replaced compose.yaml, and only then. Without it
# restore_compose fires on any .previous it finds, including one left by an
# EARLIER deploy - so a release whose compose.yaml happened to be unchanged
# would, on failing its health gate, roll the image back one version while
# reverting compose.yaml to a file from two releases ago. That pairing never
# existed anywhere, which is the exact failure this whole mechanism is for.
# Reproduced before fixing: image back to v9.0.0, compose back to the file that
# predated v9.0.0.
COMPOSE_SYNCED=0

sync_compose() {
  local ref="${1##*:}" tmp
  [ -n "$REPO_RAW" ] || return 0
  case "$ref" in
    v[0-9]*) ;;
    # --image can name anything - a digest, a local build. Only a release tag
    # has a compose.yaml that is meaningfully "the one that goes with this".
    *) log "$ref is not a release tag, keeping the current compose.yaml"; return 0 ;;
  esac

  tmp="$(mktemp)"
  if ! curl -fsS --max-time 30 "$REPO_RAW/$ref/server/compose.yaml" -o "$tmp"; then
    log "could not fetch compose.yaml for $ref, keeping the one on disk"
    rm -f "$tmp"
    return 0
  fi
  # Validate BEFORE it can replace a working file. A compose.yaml that does not
  # parse would otherwise take the service down on the next `up -d` and leave
  # nothing to roll back to.
  if ! compose -f "$tmp" --env-file "$ENV_FILE" config >/dev/null 2>&1; then
    log "compose.yaml at $ref does not validate, keeping the one on disk"
    rm -f "$tmp"
    return 0
  fi
  if cmp -s "$tmp" "$DIR/compose.yaml"; then
    rm -f "$tmp"
    return 0
  fi
  cp "$DIR/compose.yaml" "$DIR/compose.yaml.previous"
  mv "$tmp" "$DIR/compose.yaml"
  chmod 644 "$DIR/compose.yaml"
  COMPOSE_SYNCED=1
  log "compose.yaml updated from $ref"
}

restore_compose() {
  [ "$COMPOSE_SYNCED" = 1 ] || return 0
  [ -f "$DIR/compose.yaml.previous" ] || return 0
  mv "$DIR/compose.yaml.previous" "$DIR/compose.yaml"
  log "restored the previous compose.yaml"
}

# Healthy means BOTH the container's own healthcheck has passed and the relay
# answers through the proxy. The first alone would call a container healthy
# while Caddy could not reach it; the second alone would accept a stale
# container still answering while the new one crash-loops behind it.
wait_healthy() {
  local name deadline=$(( $(date +%s) + DEADLINE_S ))
  name="$(get_env CONTAINER_NAME)"
  name="${name:-chipseq-relay}"
  while [ "$(date +%s)" -lt "$deadline" ]; do
    local state
    state="$(docker inspect --format '{{.State.Health.Status}}' "$name" 2>/dev/null || echo missing)"
    if [ "$state" = "healthy" ] && curl -fsS --max-time 5 "$HEALTH_URL" >/dev/null 2>&1; then
      return 0
    fi
    sleep 3
  done
  return 1
}

deploy() {
  local target="$1" previous="$2"
  log "deploying $target (previous $previous)"

  # A pull that fails is not automatically fatal: the image may already be here
  # from a local build or an earlier attempt, and refusing to deploy something
  # we are holding would turn a registry blip into an outage. Only give up when
  # we genuinely do not have it - and give up BEFORE touching .env, so a
  # missing image leaves the running deploy exactly as it was.
  if ! docker pull "$target" >/dev/null 2>&1; then
    if ! docker image inspect "$target" >/dev/null 2>&1; then
      log "cannot pull $target and no local copy - leaving $previous running"
      return 1
    fi
    log "pull failed, using the local copy of $target"
  fi

  sync_compose "$target"

  set_env RELAY_IMAGE "$target"

  # Under `set -e` a failing `up` would abort the script outright, leaving the
  # new image AND the new compose.yaml recorded with nothing running and no
  # rollback attempted. More likely now that compose.yaml itself changes: a
  # file whose volume or network the box cannot satisfy fails here rather than
  # at the health gate.
  if ! compose up -d >/dev/null 2>&1; then
    log "compose up failed for $target"
  elif wait_healthy; then
    set_env RELAY_IMAGE_PREVIOUS "$previous"
    # Nothing consumes this after a success: --rollback re-fetches the file for
    # the tag it is going back to. Leaving it would only be a file whose name
    # stops being true at the next deploy.
    rm -f "$DIR/compose.yaml.previous"
    COMPOSE_SYNCED=0
    log "healthy on $target"
    return 0
  fi

  log "NOT healthy within ${DEADLINE_S}s, rolling back to $previous"
  restore_compose
  set_env RELAY_IMAGE "$previous"
  compose up -d >/dev/null
  if wait_healthy; then
    log "rolled back to $previous"
  else
    log "ROLLBACK ALSO UNHEALTHY - relay is down, needs a human"
  fi
  return 1
}

current="$(get_env RELAY_IMAGE)"
previous="$(get_env RELAY_IMAGE_PREVIOUS)"

if [ "$ROLLBACK" = 1 ]; then
  [ -n "$previous" ] || { log "no RELAY_IMAGE_PREVIOUS to roll back to"; exit 1; }
  deploy "$previous" "$current"
  exit $?
fi

if [ -n "$PINNED" ]; then
  [ "$PINNED" = "$current" ] && { log "already on $current"; exit 0; }
  deploy "$PINNED" "$current"
  exit $?
fi

# Tags in the registry. skopeo would be tidier, but this needs no package on
# the box beyond curl. Read the list once and judge it in two steps, because
# "the registry did not answer" and "it answered, with no releases yet" want
# different messages - conflating them sends you to check a package's
# visibility when the real answer is that nobody has tagged one.
token="$(curl -fsS "https://ghcr.io/token?scope=repository:${IMAGE#ghcr.io/}:pull" 2>/dev/null \
  | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
tags="$(curl -fsS -H "Authorization: Bearer ${token:-}" \
  "https://ghcr.io/v2/${IMAGE#ghcr.io/}/tags/list" 2>/dev/null || true)"

if [ -z "$tags" ]; then
  log "cannot read tags from $IMAGE - registry unreachable, or the package is private"
  exit 1
fi

newest="$(printf '%s' "$tags" | tr ',' '\n' \
  | sed -n 's/.*"\(v[0-9][0-9.]*\)".*/\1/p' | sort -V | tail -1)"

if [ -z "$newest" ]; then
  log "no v* tags in $IMAGE yet - nothing released to deploy"
  exit 0
fi

target="$IMAGE:$newest"
if [ "$target" = "$current" ]; then
  log "already on $current"
  exit 0
fi

deploy "$target" "$current"
