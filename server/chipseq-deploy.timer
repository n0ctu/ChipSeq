[Unit]
Description=Check for a newer ChipSeq relay image

[Timer]
# Every ten minutes. A release is not urgent. Note there is no idle guard: a
# newer tag deploys on the next tick even while badges are connected -
# adoptions survive it, live playback is cut for a few seconds. Stop this
# timer for a set that matters.
OnBootSec=5min
OnUnitActiveSec=10min
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
